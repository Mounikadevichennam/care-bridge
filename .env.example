# CareBridge AI — Environment Configuration Template
# Copy this file to .env and configure for your environment.

# Flask Application Secret Key (Used for session cryptography and CSRF)
# In production, set to a 64-character random hex string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=carebridge-dev-secret-key-change-in-production

# Canonical Path to Organizer Dataset Directory
# Default points to the verified organizer dataset location
ORGANIZER_DATA_DIR=C:\Users\Mounika\Downloads\phase-20261024125258-H2_Discharge_Summary_to_Care_Plan_v1_0\H2_Discharge_Summary_to_Care_Plan\data

# Optional Custom SQLite Database Path
# Leave blank to use default (FULL_CODE/carebridge.db)
# CAREBRIDGE_DB_PATH=FULL_CODE/carebridge.db

# Flask Server Port & Host
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
